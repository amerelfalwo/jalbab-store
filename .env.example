# ==========================================
# متغيرات البيئة الخاصة بإنتاج Vercel (Production)
# قم بتعيين هذه المتغيرات في Vercel Dashboard -> Settings -> Environment Variables
# ==========================================

# 1. مفتاح الأمان (SECRET_KEY)
SECRET_KEY=django-insecure-generate-a-strong-random-50-character-key-here

# 2. وضع التطوير (Must be False in Production)
DEBUG=False

# 3. النطاقات المسموحة
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# 4. أصول CSRF الموثوقة
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# 5. قاعدة البيانات (PostgreSQL - مطلوب لأن فيرسيل Serverless ولا تحفظ SQLite)
# يمكنك استخدام قاعدة بيانات مجانية من Supabase أو Neon.tech أو Vercel Postgres
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# 6. رفع الصور والوسائط (Cloudinary - مطلوب لأن بيئة فيرسيل Read-Only)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret