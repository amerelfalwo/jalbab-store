# ==========================================
# متغيرات البيئة الخاصة بإنتاج Vercel (Production) مع Supabase
# قم بتعيين هذه المتغيرات في Vercel Dashboard -> Settings -> Environment Variables
# ==========================================

# 1. مفتاح الأمان (Django Secret Key)
SECRET_KEY=uLuGSxKZc-Gno0IqsCUMV6Y6T0JBCVjPHkgM8w71Ulo6wm0GOtTDKvB3d46YCT3bh5I

# 2. وضع التطوير (Must be False in Production)
DEBUG=False

# 3. النطاقات المسموحة
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# 4. أصول CSRF الموثوقة
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# 5. قاعدة بيانات Supabase (PostgreSQL)
# احصل على رابط Pooler Connection String من Supabase:
# Settings -> Database -> Connection String -> URI (Mode: Transaction/Session)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# 6. Cloudinary (لحفظ الوسائط والصور في الإنتاج)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret